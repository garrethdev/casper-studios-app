# Copy to .env.local (git-ignored). Local development generates its own dev keys in .data/.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Production only (Vercel). Never commit real values.
# DATABASE_URL=postgresql://...
# JWT_PRIVATE_KEY=   (identity only)
# JWT_PUBLIC_KEY=    (meals only)
# SERVICE_SECRET_IDENTITY=  (identity + web)
# SERVICE_SECRET_MEALS=     (meals + web)
# SERVICE_SECRET_INTELLIGENCE= (intelligence + meals)
# IDENTITY_URL= MEALS_URL= INTELLIGENCE_URL= APP_ORIGIN=
